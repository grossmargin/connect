# Copy to .env and fill in. .env is gitignored.

# Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credentials

# AES-256-GCM keys: comma-separated 32-byte base64 values, newest first.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Auth.js (NextAuth). AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set to true when running behind a proxy / on Vercel.
AUTH_TRUST_HOST=true
# Restrict Google sign-in to these Workspace domains (comma-separated). Unset =
# allow any Google account.
# AUTH_ALLOWED_DOMAINS=example.com,other.com

# Public base URL of this app.
APP_URL=http://localhost:3000

# DEBUG ONLY. Authorize every request as this user (must already exist); no login.
# NEVER set in production.
# __USAFE_PERMANENT_LOGIN=you@example.com

# Claude OTLP telemetry intake. Endpoint: ${APP_URL}/otlp/<teamId>/v1/{traces|logs}
# Keys: comma-separated HMAC-SHA256(key, salt) hex hashes; any match authenticates.
# Salt: dedicated secret; falls back to AUTH_SECRET if unset. openssl rand -base64 32
CLAUDE_OTLP_INTAKE_KEYS=
CLAUDE_OTLP_INTAKE_SALT=

# Nango — dynamic OAuth tokens for NANGO-type credentials.
# Environment secret key from Nango dashboard -> Environment settings -> API keys.
NANGO_SECRET_KEY=
# Optional. Defaults to https://api.nango.dev; set for self-hosted Nango.
# NANGO_HOST=https://api.nango.dev
